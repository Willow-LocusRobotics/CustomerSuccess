# Salesforce ServiceCloud Connection
SF_LOGIN_URL=https://login.salesforce.com
SF_CLIENT_ID=your_connected_app_consumer_key
SF_CLIENT_SECRET=your_connected_app_consumer_secret
SF_USERNAME=your_integration_user@company.com
SF_PASSWORD=your_password_plus_security_token

# --- Incident Triage Agent -------------------------------------------------
# Anthropic (internal LLM — replaces the OpenAI approach Willow flagged
# as not privacy-safe in the Teams thread).
ANTHROPIC_API_KEY=sk-ant-...

# Microsoft Graph (Outlook mailbox to monitor). Requires an Azure AD app
# registration with Mail.Read (and Mail.ReadWrite if the agent should mark
# messages as read) granted as Application permissions.
MS_GRAPH_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_GRAPH_CLIENT_SECRET=your_client_secret
# Mailbox to monitor — the user principal name or object id of the
# shared/support mailbox (e.g. support@locusrobotics.com).
MS_GRAPH_MAILBOX=support@example.com

# Slack Incoming Webhook the agent posts high-priority incidents to.
SLACK_INCIDENT_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ
# Optional: override the default channel/username/icon that appear in Slack.
SLACK_INCIDENT_CHANNEL=#support-incidents

# Optional: override agent defaults.
# INCIDENT_AGENT_MODEL=claude-opus-4-6
# INCIDENT_AGENT_MAX_EMAILS=25
# Comma-separated priorities that should trigger a Slack alert (default P1,P2).
# INCIDENT_AGENT_ALERT_PRIORITIES=P1,P2
